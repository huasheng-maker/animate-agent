APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_DEMO_DIR=frontend/demo

# Optional path overrides. Relative values resolve from ANIMATE_AGENT_PROJECT_ROOT.
ANIMATE_AGENT_PROJECT_ROOT=
ANIMATE_AGENT_CONFIG_PATH=
ANIMATE_AGENT_ENV_FILE=
ANIMATE_AGENT_DATA_DIR=
ANIMATE_AGENT_ASSETS_DIR=
ANIMATE_AGENT_CACHE_DIR=

# Generation: KIMI_KEY takes precedence; otherwise DEEPSEEK_KEY is used.
# 真实密钥只写在本机 .env，不要提交。无需密钥即可打开 /demos。
DEEPSEEK_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
KIMI_KEY=
KIMI_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
LLM_TIMEOUT_SECONDS=600

# Hosted Web Search. Supported providers: gemini, openai, kimi.
# The one-key quickstart uses Kimi. Set gemini explicitly to use Gemini search.
WEB_SEARCH_PROVIDER=kimi
GEMINI_API_KEY=
GEMINI_WEB_SEARCH_MODEL=gemini-2.5-flash

# Optional OpenAI Web Search provider
OPENAI_API_KEY=
OPENAI_WEB_SEARCH_MODEL=gpt-5-mini

# Optional Kimi Tools API. It reuses KIMI_KEY/KIMI_BASE above.
# Pro is recommended when results feed DocumentIR/LLMs; basic returns result cards/full text.
KIMI_WEB_SEARCH_MODE=pro
WEB_READER_PROVIDER=local

# Xiaoyi cloud-plugin bridge. Set a random secret of at least 32 characters.
# The public origin points to the deployed Next.js frontend; HTTPS is required outside localhost.
XIAOYI_PLUGIN_TOKEN=
XIAOYI_PUBLIC_ORIGIN=

# Set to 1 only for the restricted public competition deployment.
PUBLIC_DEMO_MODE=0
