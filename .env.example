APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_DEMO_DIR=frontend/demo

# LLM (OpenAI-compatible) — 真实密钥写在 .env，不要提交
DEEPSEEK_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
KIMI_KEY=
KIMI_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
LLM_TIMEOUT_SECONDS=600

# Hosted Web Search. Supported providers: gemini, openai, kimi.
WEB_SEARCH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_WEB_SEARCH_MODEL=gemini-2.5-flash

# Optional OpenAI Web Search provider
OPENAI_API_KEY=
OPENAI_WEB_SEARCH_MODEL=gpt-5-mini

# Optional Kimi Tools API. It reuses KIMI_KEY/KIMI_BASE above.
# Pro is recommended when results feed DocumentIR/LLMs; basic returns result cards/full text.
KIMI_WEB_SEARCH_MODE=pro
WEB_READER_PROVIDER=local
